# Copy to deploy/lightrag.env and adjust models for your hardware.
# Used by `task secrets:sync` to build the Kubernetes Secret `lightrag-env`.

LIGHTRAG_RUNTIME_TARGET=compose

HOST=0.0.0.0
PORT=9621

WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs

LLM_BINDING=ollama
LLM_MODEL=qwen2.5:0.5b
LLM_BINDING_HOST=http://ollama.lightrag-stack.svc.cluster.local:11434
OLLAMA_LLM_NUM_CTX=16384
OLLAMA_LLM_NUM_PREDICT=2048

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://ollama.lightrag-stack.svc.cluster.local:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

RERANK_BINDING=null

LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

MAX_ASYNC=2
MAX_PARALLEL_INSERT=1
