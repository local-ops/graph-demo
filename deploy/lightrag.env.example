# Copy to deploy/lightrag.env and adjust models for your hardware.
# Used by `task secrets:sync` to build the Kubernetes Secret `lightrag-env`.
#
# Defaults target Apple M4 class machines with ~16 GB unified memory: community
# guides commonly recommend 7B–8B chat models (e.g. Llama 3.1 8B, Mistral 7B,
# Qwen 2.5 7B) plus a compact embedding model for local RAG.
#
# Ollama runs natively on the macOS host (Metal). Pods reach it via the Lima/Colima
# host resolver (see Colima FAQ). If your setup differs, set LLM_BINDING_HOST and
# EMBEDDING_BINDING_HOST to a reachable URL (e.g. http://192.168.5.2:11434).

LIGHTRAG_RUNTIME_TARGET=compose

HOST=0.0.0.0
PORT=9621

WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs

LLM_BINDING=ollama
LLM_MODEL=llama3.1:8b
LLM_BINDING_HOST=http://host.lima.internal:11434
OLLAMA_LLM_NUM_CTX=8192
OLLAMA_LLM_NUM_PREDICT=2048

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.lima.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

RERANK_BINDING=null

LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

MAX_ASYNC=2
MAX_PARALLEL_INSERT=1
